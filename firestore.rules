rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Auto-predictions: allow reads, block client writes
    match /predictions/{docId} {
      allow read: if true;
      allow write: if false;
    }
    match /results/{docId} {
      allow read: if true;
      allow write: if false;
    }
    match /accuracy/{docId} {
      allow read: if true;
      allow write: if false;
    }
    match /accuracyStats/{docId} {
      allow read: if true;
      allow write: if false;
    }
    match /backtests/{docId} {
      allow read: if true;
      allow write: if false;
    }
    match /models/{docId} {
      allow read, write: if false;
    }

    // Sync matches — auto leagues data written by sync.js, readable by tuning
    match /syncMatches/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Custom leagues: client read/write
    match /customLeagues/{docId} {
      allow read: if true;
      allow write: if true;
    }
    match /customMatches/{docId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
