rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // AUTO-PREDICTIONS & RESULTS: public read, no client writes
    // (sync.js uses the Admin SDK, which bypasses these rules)
    // ============================================================
    // Custom leagues CAN write documents tagged with source: "custom"
    match /predictions/{docId} {
      allow read: if true;
      allow create: if request.resource.data.source == "custom";
      allow update: if request.resource.data.source == "custom"
                    || resource.data.source == "custom";
      allow delete: if resource.data.source == "custom";
    }

    match /results/{docId} {
      allow read: if true;
      allow create: if request.resource.data.source == "custom";
      allow update: if request.resource.data.source == "custom"
                    || resource.data.source == "custom";
      allow delete: if resource.data.source == "custom";
    }

    // ============================================================
    // OTHER COLLECTIONS: read-only from client
    // ============================================================
    match /accuracy/{docId} {
      allow read: if true;
      allow write: if false;
    }
    match /accuracyStats/{docId} {
      allow read: if true;
      // Client may recompute stats after Regenerate
      allow write: if request.resource.data.keys().hasOnly([
        "totalPredictions","outcomeCorrect","scorelineCorrect",
        "outcomeAccuracy","scorelineAccuracy","avgBrierScore","avgLogLoss",
        "byLeague","windowDays","updatedAt"
      ]);
    }
    match /backtests/{docId} {
      allow read: if true;
      allow write: if false;
    }
    match /syncMatches/{docId} {
      allow read: if true;
      allow write: if false;
    }
    match /models/{docId} {
      allow read, write: if false;
    }

    // ============================================================
    // CUSTOM LEAGUES: full read/write from client
    // ============================================================
    match /customLeagues/{docId} {
      allow read: if true;
      allow write: if true;
    }
    match /customMatches/{docId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
